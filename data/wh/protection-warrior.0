<tr>
<td>Best</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=78488/souldrinker">
<img alt="Souldrinker" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_sword_1h_deathwingraiddw_d_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Souldrinker</span></a></td>
<td>
<span class="fa fa-minus fa-color-gray"></span></td>
<td>70 <a class="icontiny q1" data-entity="currency" data-game="wow" data-type="currency" href="https://www.wowhead.com/cata/currency=3281/obsidian-fragment">
<span>
<img alt="Obsidian Fragment" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_stone_15.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Obsidian Fragment</span></span></a></td>
<td>
<img alt="" class="no-border" loading="lazy" src="https://wow.zamimg.com/uploads/guide/images/27798.png"/> Zarstrasza<br/>
<img alt="" class="no-border" loading="lazy" src="https://wow.zamimg.com/images/icons/horde.png"/> Sylstrasza</td></tr>
<tr>
<td>Great</td>
