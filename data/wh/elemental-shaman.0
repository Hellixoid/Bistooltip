<td>Best</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=64673/relic-of-eonar">
<img alt="Relic of Eonar" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_elemental_mote_life01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Relic of Eonar</span></a></td>
