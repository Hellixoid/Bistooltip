<td>
<a class="q3 icontiny" data-contiguous="true" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/mop-classic/item=81561/firefinger-ring">
<img alt="Firefinger Ring" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_jewelry_ring_142.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Firefinger Ring</span></a></td>
<td>
<a data-entity="npc" href="https://www.wowhead.com/mop-classic/npc=59223/brother-korloff">
<span class="tinyicontxt">Brother Korloff</span></a> <span class="icon-heroic"></span></td></tr>
<tr>
