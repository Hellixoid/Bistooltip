<li>
<div data-markup-content-target="1">
<a class="q4 icontiny" data-contiguous="true" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/mop-classic/item=98608/white-cloud-belt">
<img alt="White Cloud Belt" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_belt_robe_panprog_b_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">White Cloud Belt</span></a></div></li></ul>
