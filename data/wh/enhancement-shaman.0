<b>Source</b></td></tr>
<tr>
<td>1</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/wotlk/item=45553/belt-of-dragons">
<img loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_belt_13.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Belt of Dragons</span></a></td>
