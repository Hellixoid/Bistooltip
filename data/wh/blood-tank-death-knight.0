}

.archon-section__banner {
   position: relative;
   width: 100%;
   height: 90px;
   border: 1px solid #242424;
   background: linear-gradient(140deg, #060606 0%, #141414 100%);
   font-size: 1.25rem;
   font-weight: 700;
   text-align: center;
   text-wrap: balance;
   text-shadow: rgba(0, 0, 0, 0) 0px 0px 1px, rgba(0, 0, 0, 0.8) 0px 1px 2px;
   text-decoration: underline;
   text-underline-offset: 5px;
   text-decoration-thickness: 1px;
   display: flex;
