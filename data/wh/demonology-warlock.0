<tr>
<td>Best</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=60250/shadowflame-leggings">
<img alt="Shadowflame Leggings" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_pants_cloth_raidwarlock_i_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Shadowflame Leggings</span></a></td>
<td>
<a class="q3 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=52205/artful-ember-topaz">
