<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=71261/gigantiform-bracers">
<img alt="Gigantiform Bracers" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_bracer_plate_raiddeathknight_j_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Gigantiform Bracers</span></a></td>
