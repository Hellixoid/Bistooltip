<tr>
<td>Optional</td>
<td>
<a class="q3 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=56397/geordans-cloak">
<img alt="Geordan's Cloak" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_misc_cape_cataclysm_melee_c_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Geordan's Cloak</span></a></td>
