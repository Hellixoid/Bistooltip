<tr>
<td>Best</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=60286/stormriders-headpiece">
<img alt="Stormrider's Headpiece" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_helmet_leather_raiddruid_i_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Stormrider's Headpiece</span></a></td>
<td>
<div class="iconsmall" data-env="cata" data-game="wow" data-tree="cata">
