<tr>
<td>5</td>
<td>Tier Pieces (<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=78823/robes-of-dying-light">
<img alt="Robes of Dying Light" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_chest_robe_raidpriest_k_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Robes of Dying Light</span></a>, <a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=78795/cowl-of-dying-light">
<img alt="Cowl of Dying Light" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_helm_robe_raidpriest_k_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Cowl of Dying Light</span></a>, <a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=78842/mantle-of-dying-light">
<img alt="Mantle of Dying Light" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_shoulder_robe_raidpriest_k_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Mantle of Dying Light</span></a>, <a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=78814/legwraps-of-dying-light">
<img alt="Legwraps of Dying Light" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_pants_robe_raidpriest_k_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Legwraps of Dying Light</span></a>)</td>
<td>45-55 <a class="icontiny q1" data-entity="currency" data-game="wow" data-type="currency" href="https://www.wowhead.com/cata/currency=3281/obsidian-fragment">
<span>
<img alt="Obsidian Fragment" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_stone_15.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Obsidian Fragment</span></span></a></td></tr></tbody></table></div></div>
