<td>Best</td>
<td>
<a class="q3 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=65168/rockslicer">
<img alt="Rockslicer" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_throwingaxe_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Rockslicer</span></a></td>
