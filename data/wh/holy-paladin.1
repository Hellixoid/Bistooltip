   font-size: 1.25rem;
   font-weight: 700;
   text-align: center;
   text-wrap: balance;
   text-shadow: rgba(0, 0, 0, 0) 0px 0px 1px, rgba(0, 0, 0, 0.8) 0px 1px 2px;
   text-decoration: underline;
   text-underline-offset: 5px;
   text-decoration-thickness: 1px;
   display: flex;
   align-items: center;
   justify-content: center;
}

@media (min-width: 1024px) {
   .archon-section__banner {
       font-size: 1.75rem;
   }
}

.archon-section__banner-bg-1, .archon-section__banner-bg-2 {
   position: absolute;
   top: 0;
   left: 0;
   bottom: 0;
   right: 0;
   background-position: center;
