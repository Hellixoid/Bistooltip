<li>
<div data-markup-content-target="1">
<a class="q4 icontiny" data-contiguous="true" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/mop-classic/item=95165/achillobator-ring">
<img alt="Achillobator Ring" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_jewelry_ring_161.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Achillobator Ring</span></a></div></li>
<li>
<div data-markup-content-target="1">
<a class="q4 icontiny" data-contiguous="true" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/mop-classic/item=95199/carnotaur-battlegloves">
<img alt="Carnotaur Battlegloves" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_gloves_plate_deathknight_m_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Carnotaur Battlegloves</span></a></div></li>
<li>
<div data-markup-content-target="1">
<a class="q4 icontiny" data-contiguous="true" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/mop-classic/item=95178/lootraptors-amulet">
<img alt="Lootraptor's Amulet" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_jewelry_necklace_131.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Lootraptor's Amulet</span></a></div></li>
