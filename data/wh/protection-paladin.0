<b>Item</b></td>
<td data-background="c2" style="width: 20%; max-width: 100%;">
<b>Sockets</b></td>
<td data-background="c2" style="width: 23%; max-width: 100%;">
<b>Source</b></td>
<td data-background="c2" style="width: 22%; max-width: 100%;">
<b>Location</b></td></tr>
<tr>
<td>Mastery+Avoidance</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=62383/wrap-of-the-great-turtle">
