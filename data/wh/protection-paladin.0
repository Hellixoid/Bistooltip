<tr>
<td>BiS BoP Crafted Mastery+Stam</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=58483/lifebound-alchemist-stone">
<img alt="Lifebound Alchemist Stone" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/spell_holy_aspiration.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Lifebound Alchemist Stone</span></a></td>
<td>
<div class="iconsmall" data-env="cata" data-game="wow" data-tree="cata">
<ins class="lazy-load-background" style='background-image: url("https://wow.zamimg.com/images/wow/icons/small/inv_misc_cutgemsuperior.jpg");'></ins>
<del></del>
<a aria-label="Icon" href="https://www.wowhead.com/cata/item=52219"></a></div></td>
