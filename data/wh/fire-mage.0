<tr>
<td>Best</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=71151/trail-of-embers">
<img alt="Trail of Embers" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_wand_1h_firelandsraid_d_01.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Trail of Embers</span></a></td>
