<b>Location</b></td></tr>
<tr>
<td>Best</td>
<td>
<a class="q4 icontiny" data-entity="item" data-entity-has-icon="true" data-game="wow" data-type="item" href="https://www.wowhead.com/cata/item=62047/darkmoon-card-volcano">
<img alt="Darkmoon Card: Volcano" loading="lazy" src="https://wow.zamimg.com/images/wow/icons/tiny/inv_inscription_tarot_volcanocard.gif" style="vertical-align: middle;"/> <span class="tinyicontxt">Darkmoon Card: Volcano</span></a></td>
